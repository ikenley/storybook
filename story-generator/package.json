{
  "name": "storybook-generator",
  "version": "1.0.0",
  "description": "syncronus task runner for creating AI-generated storybooks",
  "type": "module",
  "main": "src/lambda_function.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check",
    "ci": "biome ci",
    "format": "biome format --write",
    "lint": "biome lint",
    "lint:write": "biome lint --write",
    "test": "jest --detectOpenHandles",
    "test-coverage": "jest --coverage",
    "test-lambda": "node ./src/local.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist build"
  },
  "author": "ikenley",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikenley/storybook"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1090.0",
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/client-ses": "^3.1090.0",
    "@google/genai": "^2.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
