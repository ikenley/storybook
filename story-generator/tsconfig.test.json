// Type-checks the files the build config deliberately leaves out: test files
// and the Vitest config. Vitest only strips types at run time, so without this
// a type error in a test would never surface anywhere.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // Widened from the build config's "./src" so vitest.config.ts is in range.
    // Safe because this config never emits.
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
